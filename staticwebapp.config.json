{
  "routes": [
    {
      "route": "/admin*",
      "allowedRoles": ["admin"],
      "headers": { "Cache-Control": "no-store" }
    },
    {
      "route": "/api/admin*",
      "allowedRoles": ["admin"]
    },
    {
      "route": "/reservation-cancel.html",
      "headers": {
        "Cache-Control": "no-store",
        "Referrer-Policy": "no-referrer"
      }
    },
    {
      "route": "/stripe-webhook",
      "methods": ["POST"],
      "rewrite": "/api/stripe-webhook"
    }
  ],
  "platform": {
    "apiRuntime": "node:20"
  }
}
