{
  "name": "skucha-api",
  "version": "1.0.0",
  "private": true,
  "description": "Azure Functions backend for Skucha reservations",
  "main": "index.js",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "build:api": "node scripts/build-api.js",
    "build:site": "node scripts/build-site.js",
    "verify:build": "node scripts/verify-runtime.js",
    "lint": "eslint . --max-warnings=0",
    "ci": "npm run lint && npm run test:coverage"
  },
  "engines": {
    "node": ">=22 <25"
  },
  "dependencies": {
    "@azure/communication-email": "1.1.0",
    "@azure/data-tables": "13.3.2",
    "stripe": "22.3.2"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@vitest/coverage-v8": "4.1.11",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "vitest": "4.1.11"
  }
}
